<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>GitHubReleaseUpdater</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Only for the code the LibraryImport generator writes (the Authenticode check); there is no unsafe code of our own. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PackageId>GitHubReleaseUpdater</PackageId>
    <Authors>coldhighsun</Authors>
    <Description>Check, download and verify application updates published as GitHub Releases (github.com and GitHub Enterprise), with an optional UI-agnostic update flow.</Description>
    <PackageTags>github;release;update;updater;auto-update;semver</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/coldhighsun/GitHubReleaseUpdater.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/coldhighsun/GitHubReleaseUpdater</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- Packing fails when the public API breaks compatibility with the last released version. After a release, raise the
         baseline to it; an intended break needs a CompatibilitySuppressions.xml (dotnet pack -p:ApiCompatGenerateSuppressionFile=true). -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.6.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GitHubReleaseUpdater.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
