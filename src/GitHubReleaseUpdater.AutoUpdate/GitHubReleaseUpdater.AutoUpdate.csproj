<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>GitHubReleaseUpdater.AutoUpdate</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>GitHubReleaseUpdater.AutoUpdate</PackageId>
    <Authors>coldhighsun</Authors>
    <Description>A UI-agnostic update flow (check now and then, announce, confirm, download, launch the installer) on top of GitHubReleaseUpdater. You supply the user interface through a small presenter interface.</Description>
    <PackageTags>github;release;update;updater;auto-update;state-machine</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/coldhighsun/GitHubReleaseUpdater.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/coldhighsun/GitHubReleaseUpdater</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitHubReleaseUpdater\GitHubReleaseUpdater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
